# SINAU — .env untuk server 172.20.4.220 (dipasang oleh deploy/setup-env.sh → backend/.env)
# Secret (DB_PASSWORD, JWT_*) sengaja tidak ada di git: diisi skrip saat setup.
NODE_ENV=production
PORT=4008
APP_URL=http://172.20.4.220:4008
CORS_ORIGIN=http://172.20.4.220:4008

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=db_sinau
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=db_sinau
DB_POOL=20

JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

UPLOAD_ROOT=./uploads
UPLOAD_MAX_MB=20

SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

MAIL_MODE=outbox

RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=10

BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=superadmin123

ENABLE_JOBS=true
JOB_POLL_MS=5000

# Alesha AI: kosong = engine dummy (demo). Isi URL engine nyata bila sudah ada.
ALESHA_API_URL=

LOG_LEVEL=info
