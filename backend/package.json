{
  "name": "sinau-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SINAU API + static frontend host (Express 5, MySQL)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed:demo": "tsx src/database/seed/demo.ts",
    "db:snapshot": "tsx scripts/schemaSnapshot.ts",
    "db:dump": "tsx scripts/dbSync.ts dump",
    "db:import": "tsx scripts/dbSync.ts import"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "pdfkit": "^0.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.6"
  }
}
