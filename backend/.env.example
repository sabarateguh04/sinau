# Copy to .env — .env is git-ignored and never committed.
NODE_ENV=development
PORT=4008
APP_URL=http://localhost:4008
CORS_ORIGIN=http://localhost:4008,http://localhost:4009

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_sinau
DB_POOL=20

JWT_ACCESS_SECRET=change-me-to-32-random-bytes
JWT_REFRESH_SECRET=change-me-to-another-32-random-bytes
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# Directory for uploaded files (materials, photos, documents). Outside the repo in production.
UPLOAD_ROOT=./uploads
UPLOAD_MAX_MB=20

# Serve the built frontend (frontend/dist) from this process on PORT.
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

# Mail: outbox = append to backend/outbox/mail.log (no SMTP). Set SMTP_* to send for real (future).
MAIL_MODE=outbox

# Rate limits (per minute)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=10

# Super admin bootstrap (created once if no SUPER_ADMIN exists)
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=superadmin123

# In-process job worker (notifications, exports, retention). true/false
ENABLE_JOBS=true
JOB_POLL_MS=5000

LOG_LEVEL=info
